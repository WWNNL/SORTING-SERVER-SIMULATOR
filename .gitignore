# ================================================================ 导入缓存
# Godot 的导入产物与编辑器状态。.godot/imported 一个目录就 26MB（字体的
# SDF 图集、GLB 的网格缓存都在里面），全部能从源文件重新生成——
# 这是本项目唯一的"编译中间产物"，绝不进仓库。
.godot/

# 移动端导出时模板解压出来的东西
/android/

# ================================================================ 导出产物
# Windows / macOS 的单文件运行程序（.exe / .app / .dmg），几百 MB
/build/
# 单独导出的资源包（.app 内部的 .pck 在 build/ 里，已被上面那条覆盖）
*.pck

# ================================================================ 本地环境
# 本地测试用的假 APPDATA
.testdata/
.mcp/

# ================================================================ 系统垃圾
# macOS 的文件夹视图配置，和下面 desktop.ini 是同一类东西——
# 在 Finder 里翻过一遍仓库就会到处冒出来
.DS_Store
# Windows 资源管理器自己生成的文件夹视图配置，与项目无关
desktop.ini
Thumbs.db
